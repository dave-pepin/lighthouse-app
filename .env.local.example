NEXT_PUBLIC_SUPABASE_URL=https://jaecwneclnwdanlgakha.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ClRrlB8BEQhkgh2Bx8BrPA_IT-Den5p

# Email (Resend) — from Resend dashboard, after verifying your domain
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=updates@yourdomain.com

# Text messages (Twilio) — from Twilio Console
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid_here

# Client portal invites (Supabase Admin API) — from Supabase Settings → API,
# the "service_role" secret key. NEVER expose this in the browser — it's
# only ever read server-side.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI-suggested weekly update messages — from platform.openai.com (a
# separate account/bill from a ChatGPT Plus subscription).
OPENAI_API_KEY=your_openai_api_key_here

# Shared secret for /api/cron/send-scheduled-updates — an external
# scheduler (e.g. cron-job.org) calls that URL every few minutes with
# this as a Bearer token (or ?secret= query param) to actually send
# weekly updates that were scheduled for a past date/time. Generate with
# `openssl rand -base64 24` or similar; doesn't need to be memorable.
CRON_SECRET=your_random_secret_here

# Error monitoring (Sentry) — from your Sentry project's Settings →
# Client Keys (DSN). Safe to expose in the browser (Sentry DSNs are
# write-only, not a secret credential) — hence NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=https://your_key@your_org.ingest.us.sentry.io/your_project_id

# Optional, only needed once you want readable (non-minified) stack
# traces in production: an Auth Token from Sentry Settings → Auth Tokens
# (scope: project:releases), plus your org/project slugs. Without these,
# error capture still works fine — you just see minified traces.
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
# SENTRY_ORG=your_sentry_org_slug
# SENTRY_PROJECT=your_sentry_project_slug
