# Used only by integration tests (e.g. lib/multiTenantIsolation.test.js) that
# need a real database — never point these at production. Use the "staging"
# Supabase branch's own API settings (Project Settings → API, with that
# branch selected).
STAGING_SUPABASE_URL=https://your-staging-branch-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=sb_publishable_your_staging_anon_key
STAGING_SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_staging_service_role_key
